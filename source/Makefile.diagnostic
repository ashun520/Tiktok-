export TARGET = iphone:clang:16.5:12.0
export ARCHS = arm64
export LOGOS_DEFAULT_GENERATOR = internal

include $(THEOS)/makefiles/common.mk

TWEAK_NAME = ttgdiag

ttgdiag_FILES = Diag.m runtime.c
ttgdiag_FRAMEWORKS = UIKit
ttgdiag_CFLAGS = -fobjc-arc -Wno-deprecated-declarations
ttgdiag_LDFLAGS = --ld-path=/usr/bin/ld64.lld-18 -Xlinker -platform_version -Xlinker ios -Xlinker 12.0 -Xlinker 16.4

include $(THEOS_MAKE_PATH)/tweak.mk
